# Zufälliger, langer, geheimer String für die Session-Verschlüsselung
# z.B. erzeugen mit: openssl rand -hex 32
SESSION_SECRET=

# Initialer Admin-Benutzer — wird nur beim allerersten Start (leere Datenbank) angelegt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Auf "true" setzen, wenn die App hinter einem Reverse-Proxy mit HTTPS läuft
COOKIE_SECURE=false
